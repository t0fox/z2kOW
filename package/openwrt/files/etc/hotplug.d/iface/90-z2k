#!/bin/sh
# /etc/hotplug.d/iface/90-z2k - WAN-события БЕЗ рестарта демона.
#
# NFQUEUE-перехват от имён интерфейсов не зависит, поэтому ifup/ifdown
# обновляют ТОЛЬКО zapret2 ifsets (lan/wan/wan6) — та же модель, что stock
# 90-zapret2 в nftables-ветке. Полного рестарта нет by design.
#
# ПОЧЕМУ НЕ stock 90-zapret2. Stock гейтится на `zapret2 enabled`, а в нашей
# модели сервис zapret2 намеренно DISABLED (его daemon-половина не
# используется — OPT_BASE собирает адаптер, см. firewall.sh), поэтому stock
# hotplug не сработал бы никогда. Этот файл — единственный АКТИВНЫЙ вызов
# zapret_reload_ifsets; дублирования операции нет, гейт — на z2k enabled.

[ -n "$INTERFACE" ] || exit 0
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ] || exit 0
[ -x /etc/init.d/z2k ] || exit 0
/etc/init.d/z2k enabled || exit 0

Z2K_ROOT="${Z2K_ROOT:-/usr/lib/z2k}"
Z2K_ETC="${Z2K_ETC:-/etc/z2k}"
# shellcheck disable=SC1090,SC1091
. "$Z2K_ROOT/platform/openwrt/paths.sh" || exit 0
. "$Z2K_ROOT/platform/openwrt/env.sh" || exit 0
. "$Z2K_ROOT/platform/openwrt/firewall.sh" || exit 0

logger -t z2k "reloading zapret2 ifsets due to $ACTION of $INTERFACE (daemon untouched)"
z2k_ow_fw_reload_ifsets
# TG rules reconverge (Stage 3): sets переживают flap, правила доставляем
# идемпотентно; демон НЕ трогаем (PID stable). tg.sh может отсутствовать
# на старом payload — тогда молча скипаем (правил всё равно нет).
if [ -f "$Z2K_ROOT/platform/openwrt/tg.sh" ]; then
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/tg.sh" 2>/dev/null && \
        z2k_ow_tg rules 2>/dev/null || true
fi
# RT rules reconverge (Stage 4): nft + whitelist, DNS только verify без
# commit; демон НЕ трогаем. Аналогичный guard отсутствия файла.
if [ -f "$Z2K_ROOT/platform/openwrt/rt.sh" ]; then
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/rt.sh" 2>/dev/null && \
        z2k_ow_rt rules 2>/dev/null || true
fi
# WARP rules reconverge (Stage 5): sets (если изменились) + nft; PBR:
# untouched if valid, restore if vanished+ready. Демон НЕ трогаем.
if [ -f "$Z2K_ROOT/platform/openwrt/warp.sh" ]; then
    Z2K_WARP_SOURCE_ONLY=1; export Z2K_WARP_SOURCE_ONLY
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/warp.sh" 2>/dev/null && \
        z2k_ow_warp rules 2>/dev/null || true
fi
