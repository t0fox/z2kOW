#!/bin/sh /etc/rc.common
# /etc/init.d/z2k - тонкий procd-оркестратор z2k на OpenWrt.
#
# Порядок старта: bootstrap (идемпотентно) → генерация /etc/z2k/config штатным
# create_official_config → запуск nfqws2 с полным z2k OPT_BASE → применение
# firewall ЧЕРЕЗ zapret2 runtime → z2k custom.d.
# Владение ресурсами — см. platform/openwrt/firewall.sh (таблица).
#
# Требуется DISABLED сервис zapret2: его daemon-половина не используется
# (stock OPT_BASE без z2k lua-init), firewall-функции вызываются напрямую.

USE_PROCD=1
# after network, слот рядом с zapret2(21) — его сервис при этом выключен.
START=22

Z2K_ROOT="${Z2K_ROOT:-/usr/lib/z2k}"
Z2K_ETC="${Z2K_ETC:-/etc/z2k}"
Z2K_RUN="${Z2K_RUN:-${Z2K_TMP:-/tmp/z2k}/runtime}"

z2k_load_adapter() {
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/paths.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/env.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/uci.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/bootstrap.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/generate.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/state.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/optbase.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/firewall.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/tg.sh" || return 1
    . "$Z2K_ROOT/platform/openwrt/rt.sh" || return 1
    Z2K_WARP_SOURCE_ONLY=1; export Z2K_WARP_SOURCE_ONLY
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/warp.sh" || return 1
    . "$Z2K_LIB/utils.sh" || return 1
    . "$Z2K_LIB/strategies.sh" || return 1
    . "$Z2K_LIB/config_official.sh" || return 1
    return 0
}

# BusyBox builds differ: some have an executable usleep applet, some only
# whole-second sleep. Probe the operation itself once, then use 50 ms polls
# against one absolute deadline. This keeps the fallback bounded and avoids
# turning a fast process start into an artificial one-second wait.
Z2K_FRACSLEEP="${Z2K_FRACSLEEP:-}"
_z2k_ow_fracsleep_avail() {
    [ -n "$Z2K_FRACSLEEP" ] || {
        if usleep 1 >/dev/null 2>&1; then Z2K_FRACSLEEP=1; else Z2K_FRACSLEEP=0; fi
    }
    [ "$Z2K_FRACSLEEP" = "1" ]
}
_z2k_ow_poll_sleep() {
    if _z2k_ow_fracsleep_avail; then usleep 50000 2>/dev/null; else sleep 1; fi
}
_z2k_ow_deadline() {
    local _now
    _now=$(date +%s 2>/dev/null || echo 0)
    case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
    printf '%s' $((_now + ${1:-0}))
}
_z2k_ow_before_deadline() {
    local _now
    _now=$(date +%s 2>/dev/null || echo 0)
    case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
    [ "$_now" -lt "$1" ]
}

# Bounded wait: nfqws2 запущен И держит очередь (consumer registered),
# а не просто "procd принял instance". Вызывать ТОЛЬКО из service_started
# (после commit в procd): внутри start_service процессов ещё нет — procd
# спавнит их после возврата. Таймаут переопределяем для тестов.
_z2k_ow_wait_consumer() {
    local _deadline
    _deadline="$(_z2k_ow_deadline "${Z2K_START_CONSUMER_TIMEOUT:-30}")"
    while :; do
        z2k_ow_nfqws_consumer_ready && return 0
        _z2k_ow_before_deadline "$_deadline" || break
        _z2k_ow_poll_sleep
    done
    echo "z2k-openwrt: consumer timeout: nfqws2 не держит очередь $_q" >&2
    return 1
}

# Bounded wait TG/RT-процессов (тоже только post-commit). Короткий: procd
# спавнит быстро; долгий вис — уже не старт, а залипание.
_z2k_ow_wait_feature() {
    local _what="$1" _deadline
    _deadline="$(_z2k_ow_deadline "${Z2K_START_FEATURE_TIMEOUT:-15}")"
    while :; do
        case "$_what" in
            tg) z2k_ow_tg_running 2>/dev/null && return 0 ;;
            rt) z2k_ow_rt_running 2>/dev/null && return 0 ;;
        esac
        _z2k_ow_before_deadline "$_deadline" || break
        _z2k_ow_poll_sleep
    done
    echo "z2k-openwrt: feature timeout: $_what не поднялся" >&2
    return 1
}

# Откат failed start: только z2k-owned состояние, best-effort, всегда rc 0.
# Процессы бьём явно (на уборку procd при провале старта полагаться нельзя),
# partial firewall снимаем, ready отсутствует по построению (создаётся только
# в самом конце успеха). TG/RT/WARP-нули идемпотентны (converge-to-stop).
z2k_ow_start_rollback() {
    rm -f "${Z2K_CORE_READY:-$Z2K_RUN/core-ready}" 2>/dev/null
    local _pid
    _pid="$(cat "$Z2K_RUN/nfqws2.pid" 2>/dev/null)"
    [ -n "$_pid" ] && kill "$_pid" 2>/dev/null
    z2k_ow_tg 0 >/dev/null 2>&1
    z2k_ow_rt 0 >/dev/null 2>&1
    z2k_ow_warp 0 >/dev/null 2>&1
    if [ "${INIT_APPLY_FW:-1}" = "1" ]; then
        if z2k_ow_fw_remove >/dev/null 2>&1; then
            z2k_ow_offload_restore >/dev/null 2>&1
        fi
    fi
    return 0
}

start_service() {
    z2k_load_adapter || return 1
    OPENWRT_LAN="$(z2k_ow_lan)"
    export OPENWRT_LAN
    z2k_ow_bootstrap || return 1
    z2k_ow_generate || return 1
    # shellcheck disable=SC1090
    . "$Z2K_CONFIG" || return 1
    # ENABLED — master-гейт upstream-семантики (сохраняется регенерацией).
    [ "${ENABLED:-1}" = "1" ] || return 1

    # Preflight runtime ДО всего: отсутствующий движок обязан ронять start
    # здесь с точной причиной, а не job exit=0 + exit=127 потом (live-урок).
    z2k_ow_runtime_preflight || return 1

    # nfqws2 reads rotation state during Lua init, so migrate before procd
    # instance creation. A busy lock fails the start and is retried next boot.
    # Keep the lifecycle test seam usable with a deliberately minimal loader;
    # packaged OpenWrt always loads state.sh above in z2k_load_adapter.
    if command -v z2k_ow_migrate_quic_state >/dev/null 2>&1; then
        z2k_ow_migrate_quic_state || return 1
    fi

    # core-ready снимаем ПЕРВЫМ: дальше — либо новый ready в самом конце,
    # либо его отсутствие при любом провале (деградация видна /status).
    rm -f "${Z2K_CORE_READY:-$Z2K_RUN/core-ready}" "$Z2K_RUN/stopping" 2>/dev/null

    local _base _qnum
    _base="$(z2k_ow_optbase)" || return 1
    _qnum="${QNUM:-200}"

    procd_open_instance "z2k"
    # NFQWS2_OPT многострочный: ненумерованное раскрытие режет его на argv
    # ровно как do_nfqws/run_nfqws в S99zapret2.new и init.d/openwrt/zapret2.
    # shellcheck disable=SC2086
    procd_set_param command "$Z2K_NFQWS2" --qnum="$_qnum" $_base $NFQWS2_OPT
    procd_set_param pidfile "$Z2K_RUN/nfqws2.pid"
    # Bounded recovery belongs to procd, not a second shell watchdog.  Five
    # crashes in one hour open the circuit until an explicit start/restart.
    procd_set_param respawn 3600 5 5
    procd_close_instance

    # Транзакция pre-spawn (порядок E): preflight → rm ready → instance →
    # fw apply → fw verify (СТАТИКА: sets/jumps/rules, без consumer/process —
    # процессов до commit нет) → TG (DNS/nft/instance-def) → RT → WARP
    # (optional, warn-only). Process/consumer-доказательства — в
    # service_started ниже (post-commit). Любой required-провал здесь:
    # rollback + return 1 (ничего не заспавнено — откат дешёвый).
    if [ "${INIT_APPLY_FW:-1}" = "1" ]; then
        z2k_ow_offload_prepare || { z2k_ow_start_rollback; return 1; }
        z2k_ow_fw_apply && z2k_ow_fw_verify || { z2k_ow_start_rollback; return 1; }
    fi
    z2k_ow_custom_daemons 1
    # TG/CDN tunnel (Stage 3): второй procd instance + nft в runtime-таблице.
    # Прямой вызов (НЕ через custom.d-раннер): DISABLE_CUSTOM не должен
    # гасить first-class feature. procd останавливает instance сам.
    z2k_ow_tg 1 || { z2k_ow_start_rollback; return 1; }
    # RT proxy (Stage 4): третий instance + DNS-пины + nft. DNS re-assert
    # идемпотентен — gap при рестарте нет (контракт stop_proxy).
    z2k_ow_rt 1 || { z2k_ow_start_rollback; return 1; }
    # WARP (Stage 5): четвёртый instance + sets; PBR — только если proven
    # ready (на старте почти surely нет; tick доведёт). Boot никогда не
    # валит сервис (внутри — soft-fail); warn-only и здесь.
    z2k_ow_warp 1 || echo "z2k-openwrt: warp на старте soft-fail (tick доведёт)" >&2
    # Маркер "pre-spawn транзакция прошла": service_started (ниже) работает
    # только по нему. Нужен потому, что rc.common вызывает service_started
    # БЕЗУСЛОВНО — даже если start_service выше провалился (его rc при этом
    # глотается); без маркера service_started не отличил бы провал старта
    # от успеха и проверял бы несуществующие процессы.
    : > "$Z2K_RUN/starting" || { z2k_ow_start_rollback; return 1; }
    return 0
}

# service_started: вызывает rc.common ПОСЛЕ commit в procd (см. /etc/rc.common:
# start() { rc_procd start_service; ...; service_started; }), и — в отличие от
# start_service — его rc ПРОБРАСЫВАЕТСЯ в rc `init start` и дальше в job.
# Здесь — всё, что требует ЖИВЫХ процессов: consumer → TG → RT verify →
# core-ready ПОСЛЕДНИМ. Провал: loud + best-effort teardown + return 1
# (job nonzero, ready отсутствует, degraded виден).
service_started() {
    z2k_load_adapter >/dev/null 2>&1 || return 1
    # shellcheck disable=SC1090
    [ -f "$Z2K_CONFIG" ] && . "$Z2K_CONFIG"
    # Без маркера pre-spawn успеха делать нечего: start_service провалился
    # (его rc rc.common проглотил) — честный провал наружу, а не проверки
    # несуществующих процессов с последующим ложным ready.
    if [ ! -f "$Z2K_RUN/starting" ]; then
        echo "z2k-openwrt: service_started без pre-spawn успеха (start_service провалился)" >&2
        return 1
    fi
    rm -f "$Z2K_RUN/starting" 2>/dev/null
    _z2k_ow_wait_consumer || { z2k_ow_start_rollback; return 1; }
    if z2k_ow_tg_wanted 2>/dev/null; then
        _z2k_ow_wait_feature tg && z2k_ow_tg_verify || { z2k_ow_start_rollback; return 1; }
    fi
    if z2k_ow_rt_wanted 2>/dev/null; then
        _z2k_ow_wait_feature rt && z2k_ow_rt_verify || { z2k_ow_start_rollback; return 1; }
    fi
    : > "${Z2K_CORE_READY:-$Z2K_RUN/core-ready}" || { z2k_ow_start_rollback; return 1; }
    return 0
}

stop_service() {
    z2k_load_adapter || return 1
    # shellcheck disable=SC1090
    [ -f "$Z2K_CONFIG" ] && . "$Z2K_CONFIG"
    local _rc=0
    # core-ready FIRST: с этого момента гейты видят not-ready, resurrection
    # запрещена даже если teardown ниже частично провалится. Заодно снимаем
    # starting-маркер (зависший старт + stop = чисто).
    : > "$Z2K_RUN/stopping" 2>/dev/null || _rc=1
    rm -f "${Z2K_CORE_READY:-$Z2K_RUN/core-ready}" "$Z2K_RUN/starting" 2>/dev/null
    # Агрегируем ошибки (каждый шаг best-effort, но итог честный): молчаливый
    # частичный стоп хуже громкого.
    z2k_ow_custom_daemons 0 || _rc=1
    # TG chains снять (sets оставить); демона останавливает сам procd.
    z2k_ow_tg 0 || _rc=1
    # RT full stop: redirect/guard + DNS-пины снять (процесс — через procd).
    z2k_ow_rt 0 || _rc=1
    # WARP full stop: PBR down первым, затем chains (sets оставить).
    z2k_ow_warp 0 || _rc=1
    # Демона останавливает сам procd; снимаем только firewall.
    # INIT_APPLY_FW=0: fw не наш — ни снимать, ни проверять нечего, и это НЕ
    # провал (иначе внешний fw давал бы ложный nonzero стопа).
    if [ "${INIT_APPLY_FW:-1}" = "1" ]; then
        if z2k_ow_fw_remove; then
            if z2k_ow_stop_verify; then
                z2k_ow_offload_restore || _rc=1
            else
                _rc=1
            fi
        else
            _rc=1
        fi
    fi
    return $_rc
}

# z2k_ow_stop_verify — доказать ОТСУТСТВИЕ z2k-owned состояния после teardown.
# Отсутствующая chain/set == чисто (снимать было нечего); живая chain с нашим
# jump/redirect или живой PBR-tuple == грязь. Чужие правила не трогаем и не
# судим (только exact-наши маркеры).
z2k_ow_stop_verify() {
    local _tab="${Z2K_ZAPRET_NFT_TABLE:-${ZAPRET_NFT_TABLE:-zapret2}}" _rc=0
    local _c
    # Core jumps: нигде не должно остаться jump в рабочие chains.
    for _pair in "postnat_hook postnat" "prenat_hook prenat"; do
        set -- $_pair
        if nft list chain inet "$_tab" "$1" 2>/dev/null | grep -q "jump $2"; then
            echo "z2k-openwrt: stop_verify: остался jump $2 в $1" >&2
            _rc=1
        fi
    done
    # TG/RT working chains: teardown их удаляет (flush+delete) — живых быть
    # не должно. Sets остаются осознанно (их не судим).
    for _c in "${Z2K_TG_CHAIN_PRE:-z2k_tg_dst_pre}" "${Z2K_TG_CHAIN_OUT:-z2k_tg_dst_out}" \
             "${Z2K_TG_CHAIN_FWD:-z2k_tg_flt_fwd}" "${Z2K_TG_CHAIN_OUTF:-z2k_tg_flt_out}" \
             "${Z2K_TG_CHAIN_IN:-z2k_tg_flt_in}" "${Z2K_RT_CHAIN_PRE:-z2k_rt_dst_pre}" \
             "${Z2K_RT_CHAIN_OUT:-z2k_rt_dst_out}" "${Z2K_RT_CHAIN_IN:-z2k_rt_flt_in}" \
             "${Z2K_RT_CHAIN_FWD6:-z2k_rt_flt6_fwd}" "${Z2K_RT_CHAIN_OUT6:-z2k_rt_flt6_out}" \
             "${WARP_CHAIN_MARK:-z2k_warp_mark}" "${WARP_CHAIN_MSS:-z2k_warp_mss}" \
             "${WARP_CHAIN_FWD:-z2k_warp_fwd}" "${WARP_CHAIN_NAT:-z2k_warp_nat}"; do
        if nft list chain inet "$_tab" "$_c" >/dev/null 2>&1; then
            echo "z2k-openwrt: stop_verify: осталась chain $_c" >&2
            _rc=1
        fi
    done
    # RT DNS-пины: наши uci-секции должны отсутствовать.
    if _z2k_ow_rt_dns_dump 2>/dev/null | grep -q '^z2k_rt_'; then
        echo "z2k-openwrt: stop_verify: остались RT DNS-пины" >&2
        _rc=1
    fi
    # WARP PBR-tuple: exact-наше правило должно отсутствовать.
    if ip rule show 2>/dev/null | grep -qF "fwmark ${WARP_MARK:-0x80000000}/${WARP_MASK:-0x80000000} lookup ${WARP_TABLE:-989}"; then
        echo "z2k-openwrt: stop_verify: остался WARP PBR-tuple" >&2
        _rc=1
    fi
    return $_rc
}
