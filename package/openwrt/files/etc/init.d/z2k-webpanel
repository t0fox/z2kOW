#!/bin/sh /etc/rc.common
# /etc/init.d/z2k-webpanel - dedicated panel instance (Stage 6, PACKAGE-owned).
#
# Собственный lighttpd поверх НЕИЗМЕННОГО upstream frontend/CGI через тонкий
# platform adapter. Жизненный цикл НЕЗАВИСИМ от core z2k: остановка ядра
# панель не убивает и наоборот (WP6/WP23/WP24). Stock lighttpd/конфиг системы
# не трогаем. Супервизора-цикла нет — только procd bounded respawn (WP22/§30).

USE_PROCD=1
START=95

Z2K_ROOT="${Z2K_ROOT:-/usr/lib/z2k}"

start_service() {
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/webpanel.sh" || return 1
    local _cfg="" _port=""
    # Render transient config (настройки создаются, только если отсутствуют).
    _cfg="$(wp_panel_render)" || return 1
    # Точную ошибку валидации — наружу, а не в /dev/null: немая "конфиг
    # не валиден" стоила целого live-цикла диагностики (rc брать у команды,
    # не у tail: out="$(cmd 2>&1)"; rc=$?).
    _vout="$(wp_panel_validate "$_cfg" 2>&1)"; _vrc=$?
    if [ "$_vrc" != "0" ]; then
        printf '%s\n' "$_vout" >&2
        echo "z2k-webpanel: конфиг не валиден: $_cfg (причина — в выводе lighttpd выше)" >&2
        return 1
    fi
    _port="$(wp_panel_port)"
    # Чужой слушатель: FAIL LOUDLY (не kill, не reconfig). Свой — нормально.
    wp_port_free_or_ours "$_port" || {
        echo "z2k-webpanel: порт $_port занят чужим процессом — не стартую" >&2
        return 1
    }
    procd_open_instance "z2k-webpanel"
    procd_set_param command /usr/sbin/lighttpd -D -f "$_cfg"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    # procd спавнит instance ПОСЛЕ возврата из start_service. Проверка здесь
    # всегда гонка: она могла ложно ругнуться за секунду до фактического spawn.
    # Маркер передаёт post-commit readiness в service_started, как у core.
    : > "$WP_RUN_DIR/starting" || return 1
    return 0
}

service_started() {
    # Проверяем только post-commit instance этого сервиса; до marker
    # start_service провалился и ждать/переобувать чужой процесс нельзя.
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/webpanel.sh" || return 1
    local _marker="$WP_RUN_DIR/starting" _timeout="${Z2K_WEBPANEL_START_TIMEOUT:-15}"
    local _now _deadline
    [ -f "$_marker" ] || return 1
    rm -f "$_marker" 2>/dev/null
    _now=$(date +%s 2>/dev/null || echo 0)
    case "$_now" in ''|*[!0-9]*) _now=0 ;; esac
    _deadline=$((_now + _timeout))
    while [ "$_now" -lt "$_deadline" ]; do
        wp_panel_running && return 0
        sleep 1
        _now=$(date +%s 2>/dev/null || echo 0)
        case "$_now" in ''|*[!0-9]*) _now="$_deadline" ;; esac
    done
    wp_panel_running && return 0
    echo "z2k-webpanel: не поднялся за ${_timeout}s (см. лог lighttpd)" >&2
    return 1
}

status() {
    # Правдивый статус вместо procd-дефолта: pidfile + cmdline-match.
    # "active with no instances" успехом НЕ считается (rc=1, "stopped").
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/webpanel.sh" 2>/dev/null || return 1
    if wp_panel_running 2>/dev/null; then
        echo "running"
        return 0
    fi
    echo "stopped"
    return 1
}
