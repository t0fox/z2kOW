#!/bin/sh /etc/rc.common
# /etc/init.d/z2k-webpanel - dedicated panel instance (Stage 6, PACKAGE-owned).
#
# Собственный lighttpd поверх НЕИЗМЕННОГО upstream frontend/CGI через тонкий
# platform adapter. Жизненный цикл НЕЗАВИСИМ от core z2k: остановка ядра
# панель не убивает и наоборот (WP6/WP23/WP24). Stock lighttpd/конфиг системы
# не трогаем. Супервизора-цикла нет — только procd bounded respawn (WP22/§30).

USE_PROCD=1
START=95

Z2K_ROOT="${Z2K_ROOT:-/usr/lib/z2k}"

start_service() {
    # shellcheck disable=SC1090,SC1091
    . "$Z2K_ROOT/platform/openwrt/webpanel.sh" || return 1
    local _cfg="" _port=""
    # Render transient config (настройки создаются, только если отсутствуют).
    _cfg="$(wp_panel_render)" || return 1
    wp_panel_validate "$_cfg" >/dev/null 2>&1 || {
        echo "z2k-webpanel: конфиг не валиден: $_cfg" >&2
        echo "z2k-webpanel: нужен lighttpd с mod_cgi (и mod_setenv): доустановите модули" >&2
        return 1
    }
    _port="$(wp_panel_port)"
    # Чужой слушатель: FAIL LOUDLY (не kill, не reconfig). Свой — нормально.
    wp_port_free_or_ours "$_port" || {
        echo "z2k-webpanel: порт $_port занят чужим процессом — не стартую" >&2
        return 1
    }
    procd_open_instance "z2k-webpanel"
    procd_set_param command /usr/sbin/lighttpd -D -f "$_cfg"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    # Громкая проверка: жив через секунду (иначе старт формально «прошёл»,
    # а слушать некому — см. WP21).
    sleep 1
    wp_panel_running || {
        echo "z2k-webpanel: не поднялся (см. лог lighttpd)" >&2
        return 1
    }
    return 0
}
