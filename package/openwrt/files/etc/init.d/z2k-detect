#!/bin/sh /etc/rc.common
# /etc/init.d/z2k-detect - reactive DPI-discovery daemon (parity S98z2k-detect).
#
# PACKAGE-owned. Наблюдает DNS (AGH -> dnsmasq.log -> AF_PACKET — автовыбор
# внутри бинарника), пробует цели, пишет hot-вердикты в discovered-domains.txt.
# Z2K_DISCOVER flag (default OFF, как upstream): absent/0 = dormant, procd
# instance не открывается. Отдельный сервис (как S98), а не часть z2k:
# независимый lifecycle, рестарт ядра его не трогает.
# GODEBUG=asyncpreemptoff=1 — как в S98: гасит падение Go-рантайма на MIPS.

USE_PROCD=1
START=98

Z2K_ROOT="${Z2K_ROOT:-/usr/lib/z2k}"
Z2K_ETC="${Z2K_ETC:-/etc/z2k}"
Z2K_BIN="${Z2K_BIN:-$Z2K_ROOT/bin}"
Z2K_DETECT_BIN="${Z2K_DETECT_BIN:-$Z2K_BIN/z2k-detect}"

z2k_detect_flag() {
    [ -f "$Z2K_ETC/config" ] || { printf '0'; return 0; }
    _v="$(sed -n 's/^Z2K_DISCOVER=//p' "$Z2K_ETC/config" 2>/dev/null | tail -1 | tr -d '" ')"
    [ "$_v" = "1" ] && printf '1' || printf '0'
}

start_service() {
    [ "$(z2k_detect_flag)" = "1" ] || return 0
    [ -x "$Z2K_DETECT_BIN" ] || return 1
    procd_open_instance "z2k-detect"
    procd_set_param command "$Z2K_DETECT_BIN" run
    procd_set_param env GODEBUG=asyncpreemptoff=1
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
