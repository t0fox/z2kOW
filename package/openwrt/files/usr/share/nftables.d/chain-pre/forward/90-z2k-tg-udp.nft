## z2k Telegram UDP forwarded traffic.
##
## zapret2's independent forward base-chain cannot override a later fw4 drop.
## These narrowly scoped admissions are loaded by standard firewall4
## chain-pre includes; no firewall4 fork or broad LAN/VPN rule is installed.
## Outbound packets must carry the reserved Telegram mark and leave through
## the dedicated UDP TUN. Return packets must arrive from that TUN, be UDP,
## and have a source in the exact IPv4/IPv6 Telegram server prefixes used by
## the OpenWrt route helper. This deliberately does not admit generic UDP from
## the tunnel into LAN.
meta mark & 0x08000000 == 0x08000000 oifname "z2ktg0" meta l4proto udp accept comment "!z2k: Telegram UDP forwarded traffic"
iifname "z2ktg0" meta l4proto udp ip saddr { 149.154.160.0/20, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.20.0/22, 91.108.56.0/22, 91.105.192.0/23, 95.161.64.0/20, 185.76.151.0/24 } accept comment "!z2k: Telegram UDP forwarded traffic"
iifname "z2ktg0" meta l4proto udp ip6 saddr { 2001:67c:4e8::/48, 2001:b28:f23c::/47, 2001:b28:f23f::/48, 2a0a:f280::/32 } accept comment "!z2k: Telegram UDP forwarded traffic"
