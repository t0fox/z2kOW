# ВСЕ текстовые файлы — с LF, и это правило общее, а не перечень.
#
# Перечнем эта задача не решается. В репозитории нет ни одного файла, который
# едет на Windows: всё уходит либо на роутер, либо на VPS, либо в CI на
# linux-раннере. Зато видов файлов, которые туда едут, больше десятка, и
# список за ними не поспевал — пока здесь стояли только *.sh, *.lua, *.txt,
# *.ini, *.conf и *.md, Windows-чекаут отдавал CRLF всему остальному: .js,
# .css, .html, .go, Makefile, systemd-юнитам, конфигам CI (383 файла).
#
# Стоило это ВСЕГО набора поведенческих тестов панели, причём молча.
# tests/lib/panel_js.sh снимает строки import выражением с якорём конца строки
# (/^import .* from "[^"]*";$/d), а через \r якорь не дотягивается. import
# оставался в склейке, node получал ES-модули как обычный скрипт и падал с
# «Cannot use import statement outside a module» — одинаково на сломанном и на
# заведомо исправном коде. То есть на Windows эти тесты не проверяли ничего и
# сообщить об этом не могли.
#
# text=auto не трогает бинарники: их git распознаёт сам (в дереве таких 75).
* text=auto eol=lf

# Явные строки ниже общим правилом уже покрыты и оставлены НАМЕРЕННО: для них
# eol=lf задан вместе с безусловным text, поэтому эвристика «а не бинарный ли
# это файл» к ним не применяется вовсе. Это то, что ломается на роутере
# заметнее всего, и полагаться на автоопределение здесь незачем.
*.sh text eol=lf
*.lua text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.md text eol=lf
# webpanel JS deploys to the router AND is byte-parsed by test tooling
# (panel_js.sh import-stripping breaks on CRLF) — same class as UPDATES.json.
*.js text eol=lf
# Signature-bearing manifest: CRLF in a Windows checkout breaks
# UPDATES.json.sig verification (ed25519 over exact bytes). p-84.17 sync fix.
UPDATES.json text eol=lf

# z2k OpenWrt adapter: extensionless router/packaging files must stay LF
# (CRLF breaks shell/hotplug on the router). Path-scoped, additive only.
package/openwrt/Makefile text eol=lf
package/openwrt/ownership.map text eol=lf
package/openwrt/files/etc/init.d/z2k text eol=lf
package/openwrt/files/etc/init.d/z2k-webpanel text eol=lf
package/openwrt/files/etc/hotplug.d/iface/90-z2k text eol=lf
package/openwrt/files/etc/z2k/config.default text eol=lf
package/openwrt/ADAPTER_API text eol=lf
tests/openwrt/BASELINE text eol=lf
