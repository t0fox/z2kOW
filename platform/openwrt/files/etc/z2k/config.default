# /etc/z2k/config — канонический конфиг z2k на OpenWrt (shell-vars, как upstream).
#
# create_official_config ПЕРЕПИСЫВАЕТ этот файл при каждом старте, сохраняя
# только saved_*-ключи. Поэтому здесь лежат лишь ключи, чьи значения должны
# отличаться от умолчаний генератора. Остальное (NFQWS2_OPT, QNUM, marks,
# ports, AUTOHOSTLIST_*, DISABLE_IPV6...) — в коде генератора и zapret2.
# Подробности: ARCHITECTURE.md.

# Master-гейт сервиса (читает init.d/z2k; переживает регенерацию).
ENABLED=1

# OpenWrt-only TikTok CDN feed repair. Disabled until explicitly enabled.
Z2K_TIKTOK_FEED_ENABLED=0

# Пример: несколько LAN-сетей для zapret2 ifsets (по умолчанию "lan").
#OPENWRT_LAN="lan lan2"
