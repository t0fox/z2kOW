+        init_info.dc,
+    ) {
+        Ok(route) => route,
+        Err(error) => {
+            warn!(
+                "[{}] прозрачный маршрут отклонён для {}: {} (DC из рукопожатия: {:?}, media: {})",
+                peer, destination, error, init_info.dc, init_info.is_media
