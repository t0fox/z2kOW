+async fn connect_marked_tcp(host: &str, port: u16, mark: Option<u32>) -> Result<TcpStream, String> {
+    let Some(mark) = mark else {
+        return connect_tcp(host, port).await;
+    };
+    #[cfg(target_os = "linux")]
+    {
+        let mut last_error = None;
+        let addrs = lookup_host((host, port))
+            .await
+            .map_err(|e| format!("Поиск адреса TCP-хоста: {e}"))?;
+        for addr in addrs {
+            let socket = if addr.is_ipv4() {
+                TcpSocket::new_v4()
+            } else {
+                TcpSocket::new_v6()
+            }
+            .map_err(|e| format!("Создание TCP-сокета: {e}"))?;
+            set_socket_mark(&socket, mark).map_err(|e| format!("Метка SO_MARK: {e}"))?;
+            match socket.connect(addr).await {
+                Ok(stream) => return Ok(stream),
+                Err(error) => last_error = Some(error),
+            }
+        }
+        Err(format!(
+            "Подключение TCP: {}",
+            last_error.unwrap_or_else(|| io::Error::new(
+                io::ErrorKind::AddrNotAvailable,
+                "DNS не вернул адресов"
+            ))
+        ))
+    }
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = (host, port, mark);
+        Err("Метка SO_MARK поддерживается только в Linux".to_string())
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn set_socket_mark(socket: &TcpSocket, mark: u32) -> io::Result<()> {
+    let rc = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_MARK,
+            &mark as *const _ as *const libc::c_void,
+            std::mem::size_of_val(&mark) as libc::socklen_t,
+        )
+    };
+    if rc == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
