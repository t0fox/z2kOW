diff --git a/src/proxy/tests.rs b/src/proxy/tests.rs
index 2867af8..ecf4b3f 100644
--- a/src/proxy/tests.rs
+++ b/src/proxy/tests.rs
@@ -6,0 +7,80 @@ use crate::crypto::HANDSHAKE_LEN;
+#[tokio::test]
+async fn transparent_bridge_preserves_init_and_stream_bytes_across_ws_messages() {
+    use futures_util::{SinkExt, StreamExt};
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+    use tokio::net::{TcpListener, TcpStream};
+    use tokio_tungstenite::{accept_async, connect_async, tungstenite::Message};
+
+    let ws_listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let ws_addr = ws_listener.local_addr().unwrap();
+    let upload = b"client bytes split across arbitrary TCP and WS reads".to_vec();
+    let download = b"server bytes coalesced across WS messages".to_vec();
+    let expected_upload = upload.clone();
+    let expected_download = download.clone();
+    let server_upload = expected_upload.clone();
+    let server_download = expected_download.clone();
+    let server = tokio::spawn(async move {
+        let (tcp, _) = ws_listener.accept().await.unwrap();
+        let mut ws = accept_async(tcp).await.unwrap();
+        let init = match ws.next().await.unwrap().unwrap() {
+            Message::Binary(data) => data,
+            message => panic!("expected binary init, got {message:?}"),
+        };
+        let mut received = Vec::new();
+        while received.len() < server_upload.len() {
+            match ws.next().await.unwrap().unwrap() {
+                Message::Binary(data) => received.extend_from_slice(&data),
+                message => panic!("expected binary stream bytes, got {message:?}"),
+            }
+        }
+        let cut = server_download.len() / 2;
+        ws.send(Message::Binary(server_download[..cut].to_vec()))
+            .await
+            .unwrap();
+        ws.send(Message::Binary(server_download[cut..].to_vec()))
+            .await
+            .unwrap();
+        ws.close(None).await.unwrap();
+        (init, received)
+    });
+
+    let (ws, _) = connect_async(format!("ws://{ws_addr}/apiws"))
+        .await
+        .unwrap();
+    let client_listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let client_addr = client_listener.local_addr().unwrap();
+    let client = TcpStream::connect(client_addr);
+    let (accepted, client) = tokio::join!(client_listener.accept(), client);
+    let (bridge_tcp, _) = accepted.unwrap();
+    let mut client = client.unwrap();
+    let init = crate::crypto::generate_relay_init(crate::crypto::ProtoTag::Intermediate, 2);
+    let bridge = tokio::spawn(bridge_transparent_ws(
+        bridge_tcp,
+        ws,
+        init,
+        "127.0.0.1:12345".parse().unwrap(),
+        2,
+        false,
+    ));
+    for chunk in upload.chunks(7) {
+        client.write_all(chunk).await.unwrap();
+    }
+    let mut received_download = vec![0u8; expected_download.len()];
+    tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        client.read_exact(&mut received_download),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+
+    let (received_init, received_upload) = server.await.unwrap();
+    assert_eq!(received_init.as_ref(), init);
+    assert_eq!(received_upload, expected_upload);
+    assert_eq!(received_download, expected_download);
+    tokio::time::timeout(std::time::Duration::from_secs(5), bridge)
+        .await
+        .unwrap()
+        .unwrap();
+}
+
