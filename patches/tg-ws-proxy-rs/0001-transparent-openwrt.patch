+++ b/tests/transparent.rs
@@ -0,0 +1,59 @@
+use clap::Parser;
+use tg_ws_proxy_rs::crypto::{ProtoTag, generate_relay_init};
+use tg_ws_proxy_rs::transparent::parse_client_init;
+
+#[test]
+fn transparent_mode_is_an_explicit_opt_in() {
+    let config = tg_ws_proxy_rs::config::Config::try_parse_from(["tg-ws-proxy", "--transparent"])
+        .unwrap()
+        .with_defaults();
+    assert!(config.transparent);
+    assert!(
+        config.secrets.is_empty(),
+        "прозрачный режим не должен создавать секрет прокси"
+    );
+}
+
+#[test]
+fn transparent_mode_discards_relay_secrets_and_tls_bypass_options() {
+    let config = tg_ws_proxy_rs::config::Config::try_parse_from([
+        "tg-ws-proxy",
+        "--transparent",
+        "--secret",
+        "0123456789abcdef0123456789abcdef",
+        "--mtproto-proxy",
+        "relay.example:443:0123456789abcdef0123456789abcdef",
+        "--danger-accept-invalid-certs",
+    ])
+    .unwrap()
+    .with_defaults();
+    assert!(config.secrets.is_empty());
+    assert!(config.mtproto_proxies.is_empty());
+    assert!(config.pinned_upstreams.is_empty());
+    assert!(config.pinned_media_upstreams.is_empty());
+    assert!(!config.skip_tls_verify);
+    assert!(config.no_outbound_proxy);
+}
+
+#[test]
+fn transparent_init_accepts_dc_and_media_marker_without_a_proxy_secret() {
+    let init = generate_relay_init(ProtoTag::Intermediate, -4);
+    let parsed = parse_client_init(&init).expect("корректный obfuscated2-пакет без секрета");
+    assert_eq!(parsed.dc, 4);
+    assert!(parsed.is_media);
+    assert_eq!(parsed.proto, ProtoTag::Intermediate);
+}
+
+#[test]
+fn transparent_init_accepts_cdn_dc_203() {
+    let init = generate_relay_init(ProtoTag::PaddedIntermediate, 203);
+    let parsed = parse_client_init(&init).expect("начальный пакет DC203");
+    assert_eq!(parsed.dc, 203);
+    assert!(!parsed.is_media);
+}
+
+#[test]
+fn transparent_init_rejects_unknown_dc_and_random_data() {
+    assert!(parse_client_init(&generate_relay_init(ProtoTag::Intermediate, 6)).is_none());
+    assert!(parse_client_init(&[0; 64]).is_none());
+}
