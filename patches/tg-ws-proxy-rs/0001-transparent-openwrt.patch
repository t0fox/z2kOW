@@ -462,0 +468,205 @@ pub async fn handle_client_with_runtime(
+/// Путь для прозрачного перехвата правилами REDIRECT на роутере. Начальный
+/// пакет obfuscated2 содержит DC и признак media, а SO_ORIGINAL_DST — точный IP DC.
+/// Начальный пакет и все последующие байты передаются выбранному узлу без изменений.
+pub async fn handle_transparent_client_with_runtime(
+    mut stream: TcpStream,
+    peer: SocketAddr,
+    config: Arc<Config>,
+    pool: Arc<WsPool>,
+    runtime: Arc<Runtime>,
+) {
+    let destination = match transparent::original_destination(&stream) {
+        Ok(destination) if destination.port() == 443 => destination,
+        Ok(destination) => {
+            debug!(
+                "[{}] прозрачное перенаправление отклонено: порт назначения не 443 ({})",
+                peer, destination
+            );
+            return;
+        }
+        Err(error) => {
+            warn!(
+                "[{}] прозрачное перенаправление: SO_ORIGINAL_DST недоступен: {}",
+                peer, error
+            );
+            return;
+        }
+    };
+    let _ = stream.set_nodelay(true);
+
+    let mut init = [0u8; crate::crypto::HANDSHAKE_LEN];
+    match tokio::time::timeout(
+        Duration::from_secs(config.handshake_timeout),
+        stream.read_exact(&mut init),
+    )
+    .await
+    {
+        Ok(Ok(_)) => {}
+        Ok(Err(error)) => {
+            debug!(
+                "[{}] не удалось прочитать начальный пакет obfuscated2: {}",
+                peer, error
+            );
+            return;
+        }
+        Err(_) => {
+            debug!(
+                "[{}] истекло время ожидания начального пакета obfuscated2",
+                peer
+            );
+            return;
+        }
+    }
+    let Some(init_info) = transparent::parse_client_init(&init) else {
+        debug!("[{}] некорректный начальный пакет obfuscated2", peer);
+        return;
+    };
+    let dc_idx = if init_info.is_media {
+        -(init_info.dc as i16)
+    } else {
+        init_info.dc as i16
+    };
+    let label = peer;
+    let target_ip = destination.ip().to_string();
+    let route = Route {
+        label,
+        config: &config,
+        runtime: &runtime,
+        pool: &pool,
+        timeouts: Timeouts::from_config(&config),
+        dc: init_info.dc,
+        is_media: init_info.is_media,
+        media: media_tag(init_info.is_media),
+        dc_idx,
+        proto: init_info.proto,
+    };
+    let Some(upstream) = select_upstream(&route, Some(&target_ip)).await else {
+        return;
+    };
+    match upstream {
+        Upstream::Ws { ws, .. } => {
+            bridge_transparent_ws(stream, ws, init, label, init_info.dc, init_info.is_media).await;
+        }
+        Upstream::Tcp(host) => {
+            match runtime
+                .outbound()
+                .connect(&host, destination.port(), route.timeouts.tcp_fallback)
+                .await
+            {
+                Ok(mut remote) => {
+                    if let Err(error) = remote.write_all(&init).await {
+                        warn!(
+                            "[{}] не удалось передать начальный пакет по резервному TCP: {}",
+                            peer, error
+                        );
+                        return;
+                    }
+                    let mut client = stream;
+                    if let Err(error) =
+                        tokio::io::copy_bidirectional(&mut client, &mut remote).await
+                    {
+                        debug!("[{}] резервное TCP-соединение закрыто: {}", peer, error);
+                    }
+                }
+                Err(error) => warn!(
+                    "[{}] не удалось открыть резервное TCP-соединение с {}: {}",
+                    peer, host, error
+                ),
+            }
+        }
+        Upstream::Mtproto(_) => {
+            warn!(
+                "[{}] прозрачный режим не использует внешний MTProto-релей",
+                peer
+            );
+        }
+    }
+}
+
+async fn bridge_transparent_ws(
+    stream: TcpStream,
+    ws: TgWsStream,
+    init: [u8; crate::crypto::HANDSHAKE_LEN],
+    label: SocketAddr,
+    dc: u32,
+    is_media: bool,
+) {
+    let (mut client_read, mut client_write) = stream.into_split();
+    let (ws_write, mut ws_read) = ws.split();
+    let ws_write = Arc::new(AsyncMutex::new(ws_write));
+
+    let mut upload = tokio::spawn({
+        let ws_write = Arc::clone(&ws_write);
+        async move {
+            if ws_write
+                .lock()
+                .await
+                .send(Message::Binary(init.to_vec()))
+                .await
+                .is_err()
+            {
+                return;
+            }
+            let mut buffer = vec![0u8; RELAY_BUF_SIZE];
+            loop {
+                let length = match client_read.read(&mut buffer).await {
+                    Ok(0) | Err(_) => break,
+                    Ok(length) => length,
+                };
+                if ws_write
+                    .lock()
+                    .await
+                    .send(Message::Binary(buffer[..length].to_vec()))
+                    .await
+                    .is_err()
+                {
+                    break;
+                }
+            }
+            let _ = ws_write.lock().await.close().await;
+        }
+    });
+
+    let mut download = tokio::spawn(async move {
+        while let Some(message) = ws_read.next().await {
+            match message {
+                Ok(Message::Binary(data)) => {
+                    if client_write.write_all(&data).await.is_err() {
+                        break;
+                    }
+                }
+                Ok(Message::Text(data)) => {
+                    if client_write.write_all(data.as_bytes()).await.is_err() {
+                        break;
+                    }
+                }
+                Ok(Message::Ping(data)) => {
+                    if ws_write
+                        .lock()
+                        .await
+                        .send(Message::Pong(data))
+                        .await
+                        .is_err()
+                    {
+                        break;
+                    }
+                }
+                Ok(Message::Pong(_)) => {}
+                _ => break,
+            }
+        }
+        let _ = client_write.shutdown().await;
+    });
+
+    tokio::select! {
+        _ = &mut upload => download.abort(),
+        _ = &mut download => upload.abort(),
+    }
+    info!(
+        "[{}] сессия WSS для DC{}{} закрыта",
+        label,
+        dc,
+        media_tag(is_media)
+    );
+}
+
