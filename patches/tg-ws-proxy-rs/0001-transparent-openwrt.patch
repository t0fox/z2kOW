@@ -462,0 +468,366 @@ pub async fn handle_client_with_runtime(
+/// Путь для прозрачного перехвата правилами REDIRECT на роутере. Начальный
+/// пакет obfuscated2 содержит DC и признак media, а SO_ORIGINAL_DST — точный IP DC.
+/// Начальный пакет и все последующие байты передаются выбранному узлу без изменений.
+pub async fn handle_transparent_client_with_runtime(
+    mut stream: TcpStream,
+    peer: SocketAddr,
+    config: Arc<Config>,
+    pool: Arc<WsPool>,
+    runtime: Arc<Runtime>,
+) {
+    let destination = match transparent::original_destination(&stream) {
+        Ok(destination) => destination,
+        Err(error) => {
+            warn!(
+                "[{}] прозрачное перенаправление: SO_ORIGINAL_DST недоступен: {}",
+                peer, error
+            );
+            return;
+        }
+    };
+    debug!(
+        "[{}] исходное назначение прозрачного потока: {}",
+        peer, destination
+    );
+    if !transparent::supports_destination_port(destination.port(), &config.transparent_ports) {
+        debug!(
+            "[{}] прозрачное перенаправление отклонено: порт {} отсутствует в политике",
+            peer,
+            destination.port()
+        );
+        return;
+    }
+    if !transparent::is_telegram_destination(destination.ip(), &config.transparent_cidrs) {
+        debug!(
+            "[{}] прозрачное перенаправление отклонено: IP назначения {} не входит в CIDR Telegram",
+            peer,
+            destination.ip()
+        );
+        return;
+    }
+    let _ = stream.set_nodelay(true);
+
+    let mut init = [0u8; crate::crypto::HANDSHAKE_LEN];
+    let read_init = tokio::time::timeout(Duration::from_secs(config.handshake_timeout), async {
+        stream.read_exact(&mut init[..4]).await?;
+        if transparent::is_http_request(&init[..4]) {
+            return Ok::<bool, std::io::Error>(false);
+        }
+        stream.read_exact(&mut init[4..]).await?;
+        Ok(true)
+    })
+    .await;
+    match read_init {
+        Ok(Ok(true)) => {}
+        Ok(Ok(false)) => {
+            debug!(
+                "[{}] HTTP на TCP/{} не является прозрачным MTProto-потоком",
+                peer,
+                destination.port()
+            );
+            return;
+        }
+        Ok(Err(error)) => {
+            debug!(
+                "[{}] не удалось прочитать начальный пакет obfuscated2: {}",
+                peer, error
+            );
+            return;
+        }
+        Err(_) => {
+            debug!(
+                "[{}] истекло время ожидания начального пакета obfuscated2",
+                peer
+            );
+            return;
+        }
+    }
+    let Some(init_info) = transparent::parse_client_init(&init) else {
+        debug!(
+            "[{}] неизвестное или повреждённое рукопожатие MTProto для назначения {}",
+            peer, destination
+        );
+        return;
+    };
+    let destination_route = transparent::dc_route_for_destination(destination.ip());
+    if let (Some(handshake_dc), Some((destination_dc, destination_media))) =
+        (init_info.dc, destination_route)
+        && (handshake_dc != destination_dc || init_info.is_media != destination_media)
+    {
+        warn!(
+            "[{}] DC/медиа-несовпадение: рукопожатие DC{}{} не соответствует {} → DC{}{}",
+            peer,
+            handshake_dc,
+            media_tag(init_info.is_media),
+            destination,
+            destination_dc,
+            media_tag(destination_media)
+        );
+        return;
+    }
+    let (dc, is_media) = match (init_info.dc, destination_route) {
+        (Some(dc), _) => (dc, init_info.is_media),
+        (None, Some(route)) => route,
+        (None, None) => {
+            debug!(
+                "[{}] MTProto obfuscated2 распознан, но DC не указан и адрес {} отсутствует в точной карте дата-центров",
+                peer,
+                destination.ip()
+            );
+            return;
+        }
+    };
+    let dc_idx = if is_media { -(dc as i16) } else { dc as i16 };
+    let label = peer;
+    let target_ip = destination.ip().to_string();
+    let route = Route {
+        label,
+        config: &config,
+        runtime: &runtime,
+        pool: &pool,
+        timeouts: Timeouts::from_config(&config),
+        dc,
+        is_media,
+        media: media_tag(is_media),
+        dc_idx,
+        proto: init_info.proto,
+    };
+    let Some(upstream) = select_upstream(&route, Some(&target_ip)).await else {
+        return;
+    };
+    match upstream {
+        Upstream::Ws {
+            ws,
+            framing,
+            route_type,
+        } => {
+            bridge_transparent_ws(
+                stream,
+                ws,
+                init,
+                label,
+                destination,
+                dc,
+                is_media,
+                init_info.proto,
+                framing,
+                route_type,
+            )
+            .await;
+        }
+        Upstream::Tcp(host) => {
+            let (fallback_host, fallback_port) =
+                transparent::tcp_fallback_target(&host, destination);
+            match runtime
+                .outbound()
+                .connect(&fallback_host, fallback_port, route.timeouts.tcp_fallback)
+                .await
+            {
+                Ok(mut remote) => {
+                    if let Err(error) = remote.write_all(&init).await {
+                        warn!(
+                            "[{}] не удалось передать начальный пакет по резервному TCP: {}",
+                            peer, error
+                        );
+                        return;
+                    }
+                    let mut client = stream;
+                    match tokio::io::copy_bidirectional(&mut client, &mut remote).await {
+                        Ok((bytes_up, bytes_down)) => info!(
+                            "[{}] прозрачный маршрут=резервный TCP DC{}{} закрыт клиентом: вверх {} байт, вниз {} байт",
+                            peer,
+                            dc,
+                            media_tag(is_media),
+                            bytes_up,
+                            bytes_down
+                        ),
+                        Err(error) => debug!(
+                            "[{}] прозрачный маршрут=резервный TCP DC{}{} закрыт с ошибкой: {}",
+                            peer,
+                            dc,
+                            media_tag(is_media),
+                            error
+                        ),
+                    }
+                }
+                Err(error) => warn!(
+                    "[{}] не удалось открыть резервное TCP-соединение с {}: {}",
+                    peer, host, error
+                ),
+            }
+        }
+        Upstream::Mtproto(_) => {
+            warn!(
+                "[{}] прозрачный режим не использует внешний MTProto-релей",
+                peer
+            );
+        }
+    }
+}
+
+async fn bridge_transparent_ws(
+    stream: TcpStream,
+    ws: TgWsStream,
+    init: [u8; crate::crypto::HANDSHAKE_LEN],
+    label: SocketAddr,
+    destination: SocketAddr,
+    dc: u32,
+    is_media: bool,
+    proto: ProtoTag,
+    framing: WsFraming,
+    route_type: &'static str,
+) {
+    info!(
+        "[{}] прозрачный маршрут: {} → DC{}{} через {} (кадрирование: {})",
+        label,
+        destination,
+        dc,
+        media_tag(is_media),
+        route_type,
+        framing.as_str()
+    );
+    let (mut client_read, mut client_write) = stream.into_split();
+    let (ws_write, mut ws_read) = ws.split();
+    let ws_write = Arc::new(AsyncMutex::new(ws_write));
+    let bytes_up = Arc::new(AtomicU64::new(0));
+    let bytes_down = Arc::new(AtomicU64::new(0));
+
+    let mut upload = tokio::spawn({
+        let ws_write = Arc::clone(&ws_write);
+        let bytes_up = Arc::clone(&bytes_up);
+        async move {
+            if ws_write
+                .lock()
+                .await
+                .send(Message::Binary(init.to_vec()))
+                .await
+                .is_err()
+            {
+                return "не удалось отправить init по WSS".to_string();
+            }
+            bytes_up.fetch_add(init.len() as u64, Ordering::Relaxed);
+
+            let (mut decrypt, mut encrypt) = transparent::direct_stream_ciphers(&init);
+            let mut splitter = (framing == WsFraming::Packets).then(|| MsgSplitter::new(proto));
+            let mut buffer = vec![0u8; RELAY_BUF_SIZE];
+            let close_reason = loop {
+                let length = match client_read.read(&mut buffer).await {
+                    Ok(0) => break "клиент закрыл TCP".to_string(),
+                    Err(error) => break format!("ошибка чтения TCP клиента: {error}"),
+                    Ok(length) => length,
+                };
+
+                if let Some(splitter) = splitter.as_mut() {
+                    decrypt.apply_keystream(&mut buffer[..length]);
+                    for frame in splitter.split_and_encrypt(&mut buffer[..length], &mut encrypt) {
+                        let frame_len = frame.len() as u64;
+                        if let Err(error) = ws_write.lock().await.send(Message::Binary(frame)).await
+                        {
+                            return format!("ошибка отправки кадра WSS: {error}");
+                        }
+                        bytes_up.fetch_add(frame_len, Ordering::Relaxed);
+                    }
+                } else {
+                    if let Err(error) = ws_write
+                        .lock()
+                        .await
+                        .send(Message::Binary(buffer[..length].to_vec()))
+                        .await
+                    {
+                        return format!("ошибка отправки потока WSS: {error}");
+                    }
+                    bytes_up.fetch_add(length as u64, Ordering::Relaxed);
+                }
+            };
+
+            if let Some(splitter) = splitter.as_mut() {
+                let pending = splitter.pending_len();
+                if pending > 0 {
+                    warn!(
+                        "[{}] ошибка кадрирования MTProto: при закрытии осталось {} байт неполного пакета",
+                        label, pending
+                    );
+                }
+                for frame in splitter.flush() {
+                    let frame_len = frame.len() as u64;
+                    if let Err(error) = ws_write.lock().await.send(Message::Binary(frame)).await {
+                        return format!("ошибка отправки неполного кадра WSS: {error}");
+                    }
+                    bytes_up.fetch_add(frame_len, Ordering::Relaxed);
+                }
+            }
+
+            match ws_write.lock().await.close().await {
+                Ok(()) => close_reason,
+                Err(error) => format!("{close_reason}; ошибка закрытия WSS: {error}"),
+            }
+        }
+    });
+
+    let mut download = tokio::spawn({
+        let ws_write = Arc::clone(&ws_write);
+        let bytes_down = Arc::clone(&bytes_down);
+        async move {
+            while let Some(message) = ws_read.next().await {
+                match message {
+                    Ok(Message::Binary(data)) => {
+                        let length = data.len() as u64;
+                        if let Err(error) = client_write.write_all(&data).await {
+                            return format!("ошибка записи в TCP клиента: {error}");
+                        }
+                        bytes_down.fetch_add(length, Ordering::Relaxed);
+                    }
+                    Ok(Message::Text(data)) => {
+                        let length = data.len() as u64;
+                        if let Err(error) = client_write.write_all(data.as_bytes()).await {
+                            return format!("ошибка записи текста WSS в TCP клиента: {error}");
+                        }
+                        bytes_down.fetch_add(length, Ordering::Relaxed);
+                    }
+                    Ok(Message::Ping(data)) => {
+                        if let Err(error) = ws_write.lock().await.send(Message::Pong(data)).await {
+                            return format!("ошибка ответа на WSS ping: {error}");
+                        }
+                    }
+                    Ok(Message::Pong(_)) => {}
+                    Ok(Message::Close(frame)) => {
+                        return match frame {
+                            Some(frame) => format!(
+                                "upstream закрыл WSS: код={:?}, причина={}",
+                                frame.code, frame.reason
+                            ),
+                            None => "upstream закрыл WSS без кода".to_string(),
+                        };
+                    }
+                    Err(error) => return format!("ошибка чтения WSS: {error}"),
+                    _ => return "upstream прислал неподдерживаемый кадр WSS".to_string(),
+                }
+            }
+            let _ = client_write.shutdown().await;
+            "upstream завершил поток WSS".to_string()
+        }
+    });
+
+    let (closed_by, reason) = tokio::select! {
+        result = &mut upload => {
+            download.abort();
+            ("клиент", result.unwrap_or_else(|error| format!("задача отправки завершилась: {error}")))
+        }
+        result = &mut download => {
+            upload.abort();
+            ("upstream", result.unwrap_or_else(|error| format!("задача получения завершилась: {error}")))
+        }
+    };
+    info!(
+        "[{}] сессия DC{}{} через {} закрыта стороной {}: причина={}, вверх {} байт, вниз {} байт",
+        label,
+        dc,
+        media_tag(is_media),
+        route_type,
+        closed_by,
+        reason,
+        bytes_up.load(Ordering::Relaxed),
+        bytes_down.load(Ordering::Relaxed)
+    );
+}
